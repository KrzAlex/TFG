<?xml version="1.0" encoding="utf-8"?>
<!-- Banda de cabecera con degradado de marca y base redondeada -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="20"
        android:startColor="@color/grad_start"
        android:centerColor="@color/grad_mid"
        android:endColor="@color/grad_end" />
    <corners
        android:bottomLeftRadius="34dp"
        android:bottomRightRadius="34dp" />
</shape>
