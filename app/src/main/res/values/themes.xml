<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base. Light fijo: la UI está diseñada en claro y el robot Temi
         no usa modo oscuro; DayNight invertiría los colores hardcodeados. -->
    <style name="Theme.TemiEeg" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- ── Tipografía ─────────────────────────────────────────────────────── -->

    <!-- Título grande de pantalla / marca -->
    <style name="Text.Display" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/heading</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Cabecera de sección: MAYÚSCULAS pequeñas en color de marca -->
    <style name="Text.Overline" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Etiqueta de un ajuste / fila -->
    <style name="Text.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Texto auxiliar pequeño -->
    <style name="Text.Caption" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Valor numérico monoespaciado (umbrales, IP, contadores…) -->
    <style name="Text.ValueMono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ── Botones ────────────────────────────────────────────────────────── -->

    <!-- Acción principal: relleno de marca, esquinas amplias -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Acción secundaria: tono suave de marca -->
    <style name="Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface_tint</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Acción terciaria: solo texto -->
    <style name="Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ── Contenedores ───────────────────────────────────────────────────── -->

    <!-- Tarjeta blanca redondeada con borde sutil -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- ── Diálogos (popups) ──────────────────────────────────────────────── -->

    <style name="ShapeAppearance.TemiEeg.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ThemeOverlay.TemiEeg.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TemiEeg.Dialog</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>

    <!-- Separador horizontal fino -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

</resources>
